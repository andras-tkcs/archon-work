{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tkcs-lab/archon-work/packs/devflow/.shared/profile.schema.json",
  "title": "devflow profile (.devflow/devflow.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "docs",
    "git",
    "verify",
    "stacks"
  ],
  "$defs": {
    "command": {
      "description": "A shell command, or a mapping with options.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            },
            "cwd": {
              "type": "string",
              "description": "Directory, relative to the repo root, to run in."
            },
            "narrow": {
              "type": "string",
              "description": "Replacement command when the definition-of-done run is narrowed to some arguments; {args} is substituted."
            },
            "skip_when_narrowed": {
              "type": "boolean",
              "description": "Report n/a (partial run) when the definition-of-done run is narrowed."
            }
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Profile format version. Required; must be 1."
    },
    "toolkit": {
      "description": "ignored: the toolkit is retired"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_read"
      ],
      "properties": {
        "must_read": {
          "$ref": "#/$defs/stringList",
          "description": "Files the planner, workers and reviewer read first. May be empty."
        },
        "plan_dir": {
          "description": "ignored: retired (plans live on the plans branch)"
        },
        "adr_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Present means ADRs are used."
        },
        "adr_index": {
          "type": "string",
          "minLength": 1
        },
        "adr_bar": {
          "type": "string",
          "minLength": 1,
          "description": "Where the criteria for needing an ADR are written (path or path#anchor)."
        },
        "changelog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "section"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "description": "Heading user-visible changes go under, for example '## [Unreleased]'."
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_branch",
        "branch_pattern"
      ],
      "properties": {
        "main_branch": {
          "type": "string",
          "minLength": 1
        },
        "branch_pattern": {
          "type": "string",
          "minLength": 1
        },
        "branch_types": {
          "$ref": "#/$defs/stringList"
        },
        "merge_style": {
          "enum": [
            "merge-commit",
            "squash"
          ]
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "dod"
      ],
      "properties": {
        "fast": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "dod": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "dod_conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "do"
            ],
            "properties": {
              "when": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Globs matched against the changed files."
              },
              "do": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dod_manual": {
          "$ref": "#/$defs/stringList"
        },
        "dod_doc": {
          "type": "string",
          "minLength": 1
        },
        "ci_local": {
          "type": "object",
          "additionalProperties": false,
          "description": "Running the repository's GitHub Actions jobs locally. Absent means jobs: auto.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "jobs": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "$ref": "#/$defs/stringList"
                }
              ],
              "description": "'auto', or a list of job ids from .github/workflows/*.yml."
            },
            "skip_jobs": {
              "$ref": "#/$defs/stringList",
              "description": "Job ids never run locally."
            },
            "timeout_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra environment variables for the local run."
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatchable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow",
              "use_when"
            ],
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "use_when": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where plans live: the branch (ref) and the directory on it (dir). Absent keys fall back to 'plans'.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Branch that holds the plans."
        },
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory on that branch."
        }
      }
    },
    "stacks": {
      "$ref": "#/$defs/stringList",
      "description": "Stack knowledge files to load (knowledge/stack-<name>.md). May be empty."
    },
    "models": {
      "description": "ignored: retired (model aliases replace it)"
    },
    "project_steward": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a project doc with policy that fits no other key."
    }
  }
}
